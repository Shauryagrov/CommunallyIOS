STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
# Use the same webhook endpoint as payments (`stripeWebhook`). In Stripe Dashboard → Webhooks,
# add events: identity.verification_session.verified, .processing, .requires_input, .canceled
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# mintCustomAuthToken — MUST equal iOS OAuth CLIENT_ID (Firebase → Project settings → Your apps → GoogleService-Info CLIENT_ID)
GOOGLE_IOS_CLIENT_ID=517873979103-u3i79i0brsodur2bjago63vlgbqcajh1.apps.googleusercontent.com
# Apple Sign In — iOS bundle id used as JWT audience for native Sign in with Apple
APPLE_CLIENT_ID=shaurlabs.Communally

# Apple Sign In — token revocation (App Store Guideline 5.1.1(v)).
# All three required to enable refresh-token storage at sign-in and
# revoke-on-delete in deleteUserAccount. Without these, sign-in still
# works but App Store review will flag the deletion flow.
#
# Where to find each value:
#   APPLE_TEAM_ID     developer.apple.com → Membership → Team ID (10 chars)
#   APPLE_KEY_ID      developer.apple.com → Certificates, IDs & Profiles →
#                     Keys → create a key with "Sign In with Apple" enabled.
#                     The Key ID is 10 chars. Download the .p8 ONCE (Apple
#                     won't show it again).
#   APPLE_PRIVATE_KEY contents of the .p8 file, including the
#                     "-----BEGIN PRIVATE KEY-----" / END lines. For .env,
#                     replace real newlines with literal `\n` so it sits on
#                     one line; appleAuth.js converts them back. Better:
#                     store as a Firebase secret with
#                     `firebase functions:secrets:set APPLE_PRIVATE_KEY`.
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENTS\n-----END PRIVATE KEY-----
